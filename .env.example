# Set ONE of these. The first one found wins: LLM_BASE_URL, GROQ, OPENAI, ANTHROPIC.
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Any OpenAI compatible server (Ollama, OpenRouter, Together, vLLM):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1

# Optional: override the model for any provider
# LLM_MODEL=

# Daily limits per visitor. 0 means unlimited (handy when it's just you).
SHEETS_PER_DAY=0
SECTIONS_PER_DAY=0

# Optional: Upstash Redis for limits across serverless instances
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
